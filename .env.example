# Server port (default 3000)
PORT=3000

# ── Aiven Kafka (managed) ──────────────────────────────────────────────────────
# From the Aiven Console → Kafka service → Overview → Connection information.
# This service uses SSL client-certificate (mTLS) auth — no username/password.
#
# KAFKA_BROKER            = "Service URI"  →  your-service.aivencloud.com:12345
# KAFKA_SECURITY_PROTOCOL = SSL
# KAFKA_ACCESS_KEY        = contents of "Access Key" (service.key)  — the client private key
# KAFKA_ACCESS_CERT       = contents of "Access Certificate" (service.cert) — the client cert
# KAFKA_CA_CERT           = contents of "CA Certificate" (ca.pem)   — the project CA
#
# Each *_CERT / *_KEY var accepts either the full PEM text OR a path to a .pem file.
# If pasting PEM text inline into a .env file, keep it on one line with literal \n
# between lines (the server un-escapes them), or point the var at a file path.
KAFKA_BROKER=your-service.aivencloud.com:12345
KAFKA_SECURITY_PROTOCOL=SSL
KAFKA_ACCESS_KEY=./certs/service.key
KAFKA_ACCESS_CERT=./certs/service.cert
KAFKA_CA_CERT=./certs/ca.pem

# ── Local Kafka (docker-compose up) ────────────────────────────────────────────
# Uncomment these and comment out the Aiven lines above to use local Kafka
# KAFKA_BROKER=localhost:9092
# KAFKA_SECURITY_PROTOCOL=PLAINTEXT

# ── Aiven for Valkey (leaderboard) ─────────────────────────────────────────────
# Single connection string from the Aiven Console → Valkey service → Overview
# → "Service URI". Aiven uses TLS, so the URI starts with rediss:// —
# iovalkey enables TLS automatically for rediss:// URIs.
#   VALKEY_URI=rediss://default:password@your-service.aivencloud.com:12345
#
# Aiven's TLS cert is signed by a per-project CA that isn't in the system trust
# store, so download "CA Certificate" (ca.pem) from the service Overview and
# point VALKEY_CA_CERT at it (or paste the PEM text inline with literal \n).
#   VALKEY_CA_CERT=./certs/valkey-ca.pem
#
# Local Valkey (docker-compose) has no auth/TLS — plain redis:// and no CA:
VALKEY_URI=redis://localhost:6379
