# Server port (default 3000)
PORT=3000

# ── Public WebSocket URL (optional) ────────────────────────────────────────────
# The browser normally connects back to whatever origin served the page, so this
# can stay unset for same-host deploys. Set it only when the WS server is reached
# at a different host than the static files (e.g. a separate CDN for the game):
#   PUBLIC_WS_URL=wss://019f2325-1c3f-79b5-b8fd-327053a0043f-3000.eur-1.aiven.app

# ── Aiven Kafka (managed) ──────────────────────────────────────────────────────
# From the Aiven Console → Kafka service → Overview → Connection information.
# This service uses SSL client-certificate (mTLS) auth — no username/password.
#
# KAFKA_BROKER            = "Service URI"  →  your-service.aivencloud.com:12345
# KAFKA_SECURITY_PROTOCOL = SSL
# KAFKA_ACCESS_KEY        = contents of "Access Key" (service.key)  — the client private key
# KAFKA_ACCESS_CERT       = contents of "Access Certificate" (service.cert) — the client cert
# KAFKA_CA_CERT           = contents of "CA Certificate" (ca.pem)   — the project CA
#
# Each *_CERT / *_KEY var accepts either the full PEM text OR a path to a .pem file.
# If pasting PEM text inline into a .env file, keep it on one line with literal \n
# between lines (the server un-escapes them), or point the var at a file path.
KAFKA_BROKER=your-service.aivencloud.com:12345
KAFKA_SECURITY_PROTOCOL=SSL
KAFKA_ACCESS_KEY=./certs/service.key
KAFKA_ACCESS_CERT=./certs/service.cert
KAFKA_CA_CERT=./certs/ca.pem

# ── Local stack (docker compose up) ────────────────────────────────────────────
# The local Kafka/Valkey/Postgres containers are on an internal-only Docker
# network with NO host ports, so a server run on the host can't reach them.
# Run the whole stack in Docker instead (`mise run up`) — docker-compose.yml
# wires the server to kafka:9092 / valkey:6379 / postgres:5432 itself, and this
# file isn't used. Running on the host (`mise run dev`) targets Aiven via fnox.

# ── Aiven for Valkey (leaderboard) ─────────────────────────────────────────────
# Single connection string from the Aiven Console → Valkey service → Overview
# → "Service URI". Aiven uses TLS, so the URI starts with rediss:// —
# iovalkey enables TLS automatically for rediss:// URIs.
#   VALKEY_URI=rediss://default:password@your-service.aivencloud.com:12345
#
# Aiven's TLS cert is signed by a per-project CA that isn't in the system trust
# store, so download "CA Certificate" (ca.pem) from the service Overview and
# point VALKEY_CA_CERT at it (or paste the PEM text inline with literal \n).
#   VALKEY_CA_CERT=./certs/valkey-ca.pem
VALKEY_URI=rediss://default:password@your-service.aivencloud.com:12345

# ── PostgreSQL (daily challenge ghost persistence) ─────────────────────────────
# Stores ghost run inputs for the daily challenge so players can race against
# the day's fastest finishers across sessions.
#
# Aiven for PostgreSQL — connection string from the service Overview → Service URI.
# Aiven requires SSL; append ?sslmode=require (or =verify-full with a CA cert).
#   POSTGRES_URI=postgresql://avnadmin:password@your-pg.aivencloud.com:12345/defaultdb?sslmode=require
#   POSTGRES_CA_CERT=./certs/pg-ca.pem   # optional: path to Aiven CA for verify-full
POSTGRES_URI=postgresql://avnadmin:password@your-pg.aivencloud.com:12345/defaultdb?sslmode=require

# ── Events + marketing consent (events.js) ─────────────────────────────────────
# Events are managed in the Inkless leaderboard service — create/edit them in its
# admin console. This server only reads its public GET /api/events; nothing is
# stored here. Each event's race seed is derived from its slug ("event:<slug>").
# LEADERBOARD_URL=https://01a1c5d8-10ba-7615-bcdb-557ec417a581-8000.eur-1.aiven.app
#
# Game token for posting event race times (leaderboard admin console → API tab
# → new token, type Game, game crab-racing). Server-side only — never shipped to
# the browser. Without it event races still run but aren't posted.
#   fnox set LEADERBOARD_TOKEN
LEADERBOARD_TOKEN=
# LEADERBOARD_GAME=crab-racing
#
# Consent submitted at /event/<slug> is published to this Kafka topic
# (default marketing-consent) for processing elsewhere.
# MARKETING_TOPIC=marketing-consent
