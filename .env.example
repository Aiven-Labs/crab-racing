# Server port (default 3000)
PORT=3000

# ── Aiven Kafka (managed) ──────────────────────────────────────────────────────
# Copy your service URI from the Aiven Console → Kafka → Overview → Connection info
# Format: your-service-name.aivencloud.com:PORT
KAFKA_BROKER=your-service.aivencloud.com:12345

# Aiven credentials (SASL/SCRAM-SHA-256 over SSL)
KAFKA_USER=avnadmin
KAFKA_PASS=your-password-here

# ── Local Kafka (docker-compose up) ────────────────────────────────────────────
# Uncomment these and comment out the Aiven lines above to use local Kafka
# KAFKA_BROKER=localhost:9092
# KAFKA_USER=
# KAFKA_PASS=
