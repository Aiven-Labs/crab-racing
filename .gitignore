# Dependencies
node_modules/

# Local env / secrets
.env
.env.local

# Local game tuning — copy game-config.example.json to game-config.json and edit.
# The live file is per-deploy and shouldn't be committed (defaults live in code).
game-config.json

# Kafka client certificates & keys (Aiven mTLS) — never commit
certs/
*.pem
*.key
*.cert
fnox.toml

# Generated Prometheus config — contains basic-auth credentials (rendered from
# prometheus/prometheus.yml.tmpl by scripts/setup-prometheus.sh). ca.pem is
# already covered by *.pem above.
prometheus/prometheus.yml
