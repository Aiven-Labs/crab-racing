# Prometheus scrape config for the Aiven "crab-race-valkey" metrics integration.
#
# This is a TEMPLATE. Do not edit prometheus.yml directly — it is generated from
# this file by scripts/setup-prometheus.sh, which substitutes the ${...} vars
# below with live credentials (from fnox) and the resolved Aiven scrape target.
#
# crab-race-valkey is a single-node service, so we use static_configs. See:
# https://aiven.io/docs/platform/howto/integrations/prometheus-metrics
global:
  scrape_interval: 30s

scrape_configs:
  - job_name: aivenmetrics
    scheme: https
    basic_auth:
      username: ${PROMETHEUS_BASIC_AUTH_USERNAME}
      password: ${PROMETHEUS_BASIC_AUTH_PASSWORD}
    tls_config:
      ca_file: /etc/prometheus/ca.pem
    static_configs:
      - targets: ["${PROMETHEUS_SCRAPE_HOST}:${PROMETHEUS_SCRAPE_PORT}"]
